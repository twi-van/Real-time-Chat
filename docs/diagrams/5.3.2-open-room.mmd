sequenceDiagram
    autonumber
    participant A as Client A
    participant BE as Backend
    participant DB as Database

    A->>BE: GET /rooms (JWT)
    BE->>DB: Room của A + lastMessage
    DB-->>BE: rooms
    BE-->>A: rooms[] (sort tin mới nhất)

    A->>BE: GET /rooms/:id/messages
    BE->>DB: A có phải member?
    alt Không phải member
        BE-->>A: 403 FORBIDDEN
    else Là member
        BE->>DB: Query tin (cursor)
        DB-->>BE: messages
        BE-->>A: messages + nextCursor?
        A->>BE: join_room { roomId }
        BE->>DB: Kiểm tra membership
        alt OK
            BE->>BE: socket.join(roomId)
            BE-->>A: ack ok
        else Lỗi
            BE-->>A: ack FORBIDDEN
        end
    end
